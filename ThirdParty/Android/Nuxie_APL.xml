<?xml version="1.0" encoding="utf-8"?>
<root xmlns:android="http://schemas.android.com/apk/res/android">
  <init>
    <log text="Nuxie Android bridge init" />
  </init>

  <minimumSDKAPI>23</minimumSDKAPI>

  <gradleCopies>
    <copyFile
      src="$S(PluginDir)/lib/nuxie-unreal-bridge.aar"
      dst="$S(BuildDir)/libs/nuxie-unreal-bridge.aar" />
  </gradleCopies>

  <buildGradleAdditions>
    <insert>
repositories {
    mavenCentral()
}
dependencies {
    implementation files("libs/nuxie-unreal-bridge.aar")
    implementation "ai.nuxie:nuxie-android:0.1.0"
}
    </insert>
  </buildGradleAdditions>

  <proguardAdditions>
    <insert>
-keep class ai.nuxie.** { *; }
    </insert>
  </proguardAdditions>
</root>
